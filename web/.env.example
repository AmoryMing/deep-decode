# ── 后台登录凭证（运营 Dashboard）────────────────────────────
# 默认 muming / muming。部署到 Vercel 时在 Environment Variables 里设置同名变量覆盖。
ADMIN_USER=muming
ADMIN_PASS=muming
# 用于签名登录 cookie 的密钥，部署时务必改成一段随机长字符串。
AUTH_SECRET=change-me-to-a-long-random-string

# ── 媒体 CDN ────────────────────────────────────────────────
# 图片 / 音频走 jsDelivr，视频走 GitHub raw。内容推送在孤儿分支 deploy。
# 切换分支或锁定 commit：@deploy / @main / @<commit-sha>。
NEXT_PUBLIC_CDN_BASE=https://cdn.jsdelivr.net/gh/AmoryMing/deep-decode@deploy
NEXT_PUBLIC_RAW_BASE=https://raw.githubusercontent.com/AmoryMing/deep-decode/deploy
