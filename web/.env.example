# ── 后台登录凭证（运营 Dashboard）────────────────────────────
# 默认 muming / muming。部署到 Vercel 时在 Environment Variables 里设置同名变量覆盖。
ADMIN_USER=muming
ADMIN_PASS=muming
# 用于签名登录 cookie 的密钥，部署时务必改成一段随机长字符串。
AUTH_SECRET=change-me-to-a-long-random-string

# ── 媒体 CDN ────────────────────────────────────────────────
# 图片 / 音频走 jsDelivr（仓库已在 GitHub，零额外存储）。
# 内容当前在 cleanup 分支，故指向 @cleanup；合并到 main 后改 @main。
# 也可锁定 commit：@<commit-sha>。
NEXT_PUBLIC_CDN_BASE=https://cdn.jsdelivr.net/gh/AmoryMing/deep-decode@cleanup
# 视频（mp4 体积常超 jsDelivr 20MB 上限）走 GitHub raw。
NEXT_PUBLIC_RAW_BASE=https://raw.githubusercontent.com/AmoryMing/deep-decode/cleanup
